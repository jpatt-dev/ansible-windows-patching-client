---
# yamllint configuration tuned for Ansible content.
# Run with: yamllint .

extends: default

rules:
  line-length:
    max: 160
    level: warning
  truthy:
    # Ansible uses yes/no/true/false; allow the common Ansible truthy values.
    allowed-values: ["true", "false", "yes", "no"]
    check-keys: false
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  indentation:
    spaces: 2
    indent-sequences: true
  new-lines:
    type: unix
    level: warning

ignore: |
  collections/
  .venv/
  venv/
  reports/output/
